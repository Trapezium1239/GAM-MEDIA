{
  "name": "gam-church-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "build:mobile": "next build --webpack && npx cap sync",
    "cap:android": "npx cap add android && npx cap sync android",
    "cap:ios": "npx cap add ios && npx cap sync ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "prepare": "husky install",
    "ingest:telegram": "tsx scripts/ingest-telegram.ts",
    "copy:audio": "tsx scripts/copy-audio-local.ts",
    "setup:r2": "tsx scripts/setup-r2-cors.ts",
    "test:sanity": "tsx scripts/test-sanity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/ssr": "0.5.1",
    "@supabase/supabase-js": "2.45.4",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "idb": "^8.0.0",
    "lucide-react": "0.447.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "music-metadata": "^7.14.0",
    "postcss": "8.4.47",
    "prettier": "^3.0.0",
    "tailwindcss": "3.4.14",
    "tsx": "^4.0.0",
    "typescript": "5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
